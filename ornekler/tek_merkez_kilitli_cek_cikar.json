{
  "ad": "Tek Merkez Kilitli Çek-Çıkar",
  "konsept": "Üstten gelen zarf kapak, ön yüzün ortasındaki tek yarığa kilitlenir. Çekme şeridi kartların altından U çizip arka panelin yarığından dışarı çıkar: kapak kapalıyken bile tutma ucu arka yüzde görünür. Kapağı açıp ucu yukarı çekince kartlar yükselir. Dikişsiz; yalnız şerit iki perçinle tutturulur.",
  "kategori": "kartlik",
  "malzeme": "crazy_horse",
  "kalinlik": "1.6",
  "renk": "#6b4024",
  "degiskenler": [
    {
      "ad": "kart_adet",
      "deger": "4",
      "aciklama": "kapasite"
    },
    {
      "ad": "bosluk",
      "deger": "1.5",
      "aciklama": "yan pay"
    },
    {
      "ad": "ts",
      "deger": "1.0",
      "aciklama": "şerit kalınlığı"
    },
    {
      "ad": "S",
      "deger": "kart_adet*kart_k + 0.6",
      "aciklama": "yığın kalınlığı"
    },
    {
      "ad": "g",
      "deger": "S + t + 2*ts",
      "aciklama": "körük: kartlar + merkez kilit kafası + şeridin iki kolu"
    },
    {
      "ad": "W",
      "deger": "kart_g + 2*bosluk",
      "aciklama": "panel genişliği"
    },
    {
      "ad": "Hb",
      "deger": "kart_y + 3",
      "aciklama": "arka boy: kartlar tamamen içeride, kapak üstten kapanır"
    },
    {
      "ad": "Hf",
      "deger": "kart_y - 4",
      "aciklama": "ön boy"
    },
    {
      "ad": "sw",
      "deger": "16",
      "aciklama": "şerit genişliği"
    },
    {
      "ad": "ru",
      "deger": "(g + 2*kr - 2*ts)/2",
      "aciklama": "şeridin kartları alttan saracağı U kıvrım yarıçapı"
    },
    {
      "ad": "kdil",
      "deger": "16",
      "aciklama": "merkez kapak kilit boynu genişliği"
    },
    {
      "ad": "boyun",
      "deger": "14",
      "aciklama": "yan kilit boynu genişliği"
    },
    {
      "ad": "my",
      "deger": "ru + ts + 1.5",
      "aciklama": "şeridin ön paneldeki montaj yüksekliği"
    },
    {
      "ad": "kok",
      "deger": "26",
      "aciklama": "şerit kökü (perçinli kısım) boyu"
    },
    {
      "ad": "ky",
      "deger": "my + kok + 11",
      "aciklama": "merkez kilit yarığının ön paneldeki yüksekliği (kafa kökün üstünde kalır)"
    },
    {
      "ad": "sy",
      "deger": "Hb - 8",
      "aciklama": "şeridin arka panelden dışarı çıktığı yarığın yüksekliği"
    },
    {
      "ad": "uc",
      "deger": "26",
      "aciklama": "arka yüzde dışarıda kalan tutma ucu boyu"
    }
  ],
